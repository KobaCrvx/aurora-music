<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/n_root" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/n_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/n_rr"/>
<LinearLayout android:id="@+id/n_inner" android:layout_width="match_parent" android:layout_height="132dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <ImageView android:id="@+id/n_cover" android:layout_width="104dp" android:layout_height="104dp" android:scaleType="centerCrop"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
        <TextView android:id="@+id/n_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" android:textSize="17sp" android:textColor="#FFFFFFFF"/>
        <TextView android:id="@+id/n_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="13sp" android:textColor="#B3FFFFFF"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="4dp">
            <ImageView android:layout_width="match_parent" android:layout_height="4dp" android:scaleType="fitXY" android:src="@drawable/n_bar_track"/>
            <ImageView android:id="@+id/n_fill" android:layout_width="match_parent" android:layout_height="4dp" android:scaleType="fitXY" android:src="@drawable/n_bar_fill"/>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="3dp">
            <Chronometer android:id="@+id/n_cur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#B3FFFFFF"/>
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <ViewFlipper android:id="@+id/n_eq" android:layout_width="28dp" android:layout_height="14dp" android:autoStart="true" android:flipInterval="150">
                <ImageView android:id="@+id/n_eqf0" android:layout_width="28dp" android:layout_height="14dp" android:scaleType="fitXY" android:src="@drawable/n_eq0"/>
                <ImageView android:id="@+id/n_eqf1" android:layout_width="28dp" android:layout_height="14dp" android:scaleType="fitXY" android:src="@drawable/n_eq1"/>
                <ImageView android:id="@+id/n_eqf2" android:layout_width="28dp" android:layout_height="14dp" android:scaleType="fitXY" android:src="@drawable/n_eq2"/>
                <ImageView android:id="@+id/n_eqf3" android:layout_width="28dp" android:layout_height="14dp" android:scaleType="fitXY" android:src="@drawable/n_eq3"/>
                <ImageView android:id="@+id/n_eqf4" android:layout_width="28dp" android:layout_height="14dp" android:scaleType="fitXY" android:src="@drawable/n_eq4"/>
            </ViewFlipper>
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <TextView android:id="@+id/n_dur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#B3FFFFFF"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/n_prev" android:layout_width="44dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/n_prev"/>
            <ImageView android:id="@+id/n_play" android:layout_width="52dp" android:layout_height="40dp" android:padding="6dp" android:src="@drawable/n_play"/>
            <ImageView android:id="@+id/n_next" android:layout_width="44dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/n_next"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
