<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/n_root" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/n_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/n_rr"/>
    <LinearLayout android:id="@+id/n_inner" android:layout_width="match_parent" android:layout_height="156dp" android:orientation="vertical" android:padding="8dp" android:layout_margin="4dp" android:background="@drawable/n_cas_body">
        <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="5dp" android:background="@drawable/n_cas_label">
            <ImageView android:id="@+id/n_cover" android:layout_width="34dp" android:layout_height="34dp" android:scaleType="centerCrop"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:id="@+id/n_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:fontFamily="cursive" android:textSize="16sp" android:textColor="#FF26303D"/>
                <TextView android:id="@+id/n_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:fontFamily="cursive" android:textSize="12sp" android:textColor="#FF5A6575"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/n_cas_win">
            <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
                    <ImageView android:id="@+id/n_reelL" android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter" android:src="@drawable/n_reel"/>
                    <ViewFlipper android:id="@+id/n_spinL" android:layout_width="38dp" android:layout_height="38dp" android:autoStart="true" android:flipInterval="110"><ImageView android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter" android:src="@drawable/n_reel"/><ImageView android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter" android:src="@drawable/n_reel_r1"/><ImageView android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter" android:src="@drawable/n_reel_r2"/><ImageView android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter" android:src="@drawable/n_reel_r3"/></ViewFlipper>
                </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="3dp">
                <ImageView android:layout_width="match_parent" android:layout_height="3dp" android:scaleType="fitXY" android:src="@drawable/n_bar_track"/>
                <ImageView android:id="@+id/n_fill" android:layout_width="match_parent" android:layout_height="3dp" android:scaleType="fitXY" android:src="@drawable/n_bar_fill"/>
            </FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
                <Chronometer android:id="@+id/n_cur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:textSize="11sp" android:textColor="#FFE8DCC2"/>
                <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <TextView android:id="@+id/n_dur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:textSize="11sp" android:textColor="#FFE8DCC2"/>
            </LinearLayout>
            </LinearLayout>
            <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
                    <ImageView android:id="@+id/n_reelR" android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter" android:src="@drawable/n_reel"/>
                    <ViewFlipper android:id="@+id/n_spinR" android:layout_width="38dp" android:layout_height="38dp" android:autoStart="true" android:flipInterval="110"><ImageView android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter" android:src="@drawable/n_reel"/><ImageView android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter" android:src="@drawable/n_reel_r1"/><ImageView android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter" android:src="@drawable/n_reel_r2"/><ImageView android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter" android:src="@drawable/n_reel_r3"/></ViewFlipper>
                </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/n_prev" android:layout_width="56dp" android:layout_height="34dp" android:padding="9dp" android:src="@drawable/n_prev" android:background="@drawable/n_ck"/>
            <ImageView android:id="@+id/n_play" android:layout_width="72dp" android:layout_height="34dp" android:padding="7dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:src="@drawable/n_play" android:background="@drawable/n_ck"/>
            <ImageView android:id="@+id/n_next" android:layout_width="56dp" android:layout_height="34dp" android:padding="9dp" android:src="@drawable/n_next" android:background="@drawable/n_ck"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
