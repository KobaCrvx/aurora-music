<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/n_root" android:layout_width="match_parent" android:layout_height="150dp" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/n_retro_body">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="8dp" android:background="@drawable/n_retro_screen">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/n_cover" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="centerCrop"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                    <TextView android:id="@+id/n_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:fontFamily="monospace" android:textStyle="bold" android:textSize="14sp" android:textColor="#FF0D1C28"/>
                    <TextView android:id="@+id/n_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:fontFamily="monospace" android:textSize="11sp" android:textColor="#FF0D1C28"/>
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="3dp">
                <ImageView android:layout_width="match_parent" android:layout_height="3dp" android:scaleType="fitXY" android:src="@drawable/n_bar_track"/>
                <ImageView android:id="@+id/n_fill" android:layout_width="match_parent" android:layout_height="3dp" android:scaleType="fitXY" android:src="@drawable/n_bar_fill"/>
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
                <Chronometer android:id="@+id/n_cur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:textSize="11sp" android:textColor="#FF0D1C28"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <TextView android:id="@+id/n_dur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:textSize="11sp" android:textColor="#FF0D1C28"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
            <ImageView android:id="@+id/n_prev" android:layout_width="40dp" android:layout_height="40dp" android:padding="10dp" android:src="@drawable/n_prev" android:background="@drawable/n_retro_btn"/>
            <ImageView android:id="@+id/n_play" android:layout_width="46dp" android:layout_height="46dp" android:padding="11dp" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:src="@drawable/n_play" android:background="@drawable/n_retro_btn"/>
            <ImageView android:id="@+id/n_next" android:layout_width="40dp" android:layout_height="40dp" android:padding="10dp" android:src="@drawable/n_next" android:background="@drawable/n_retro_btn"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
