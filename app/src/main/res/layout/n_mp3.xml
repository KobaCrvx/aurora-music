<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/n_root" android:layout_width="match_parent" android:layout_height="140dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <LinearLayout android:id="@+id/n_body" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/n_ipod_body">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:padding="8dp" android:background="@drawable/n_ipod_screen">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/n_cover" android:layout_width="46dp" android:layout_height="46dp" android:scaleType="centerCrop"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                    <TextView android:id="@+id/n_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textStyle="bold" android:textSize="13sp" android:textColor="#FFFFFFFF"/>
                    <TextView android:id="@+id/n_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:textColor="#B3FFFFFF"/>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="4dp">
            <ImageView android:layout_width="match_parent" android:layout_height="4dp" android:scaleType="fitXY" android:src="@drawable/n_bar_track"/>
            <ImageView android:id="@+id/n_fill" android:layout_width="match_parent" android:layout_height="4dp" android:scaleType="fitXY" android:src="@drawable/n_bar_fill"/>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="3dp">
            <Chronometer android:id="@+id/n_cur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#B3FFFFFF"/>
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <TextView android:id="@+id/n_dur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#B3FFFFFF"/>
        </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="104dp" android:layout_height="104dp" android:layout_marginStart="10dp">
            <ImageView android:layout_width="104dp" android:layout_height="104dp" android:src="@drawable/n_wheel"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="7dp" android:text="MUSIC" android:textSize="9sp" android:textStyle="bold" android:textColor="#FF9A9AA0"/>
            <ImageView android:id="@+id/n_prev" android:layout_width="34dp" android:layout_height="34dp" android:padding="7dp" android:layout_gravity="center_vertical|start" android:layout_marginStart="3dp" android:src="@drawable/n_prev"/>
            <ImageView android:id="@+id/n_next" android:layout_width="34dp" android:layout_height="34dp" android:padding="7dp" android:layout_gravity="center_vertical|end" android:layout_marginEnd="3dp" android:src="@drawable/n_next"/>
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/n_wheel_center"/>
            <ImageView android:id="@+id/n_play" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:layout_gravity="center" android:src="@drawable/n_play"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
